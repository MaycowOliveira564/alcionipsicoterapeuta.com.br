# Nunca executar scripts dentro de uploads
<FilesMatch "\.(php|phtml|phar|php[0-9]|pl|py|cgi|sh)$">
Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
<IfModule mod_headers.c>
<FilesMatch "\.svg$">
Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:"
</FilesMatch>
</IfModule>
